# ===================================================
# SkyPulse Weather Dashboard — Backend Environment
# Copy to .env and fill in your values
# ===================================================

# Django Core
SECRET_KEY=your-super-secret-django-key-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (leave empty to use SQLite for development)
# DATABASE_URL=postgresql://user:password@localhost:5432/skypulse

# Redis (leave empty to disable caching in development)
# REDIS_URL=redis://localhost:6379/0

# OpenWeatherMap API (required for real data)
# Get your free key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# CORS (frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (optional — for weather alerts)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@skypulse.app
